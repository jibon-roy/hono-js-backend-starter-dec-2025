{
  "name": "hono-js-starter-2025-dec",
  "type": "module",
  "scripts": {
    "dev": "bun run prisma:generate && bun run --hot src/server.ts",
    "start": "bun run prisma:generate && bun run src/server.ts",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "prisma:generate": "bunx prisma generate --schema prisma/schema/schema.prisma",
    "prisma:push": "bunx prisma db push --schema prisma/schema/schema.prisma",
    "build": "bun run prisma:generate && bun run typecheck"
  },
  "dependencies": {
    "@bull-board/api": "^6.16.4",
    "@bull-board/hono": "^6.16.4",
