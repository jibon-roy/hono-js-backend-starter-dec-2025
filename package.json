    "@sendgrid/mail": "^8.1.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.9",
    "@types/passport": "^1.0.17",
    "@types/passport-facebook": "^3.0.4",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.16.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.67.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "hono": "^4.11.7",
    "http-status": "^2.1.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.13",
